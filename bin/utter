#!/usr/bin/env bash
# utter            start or stop a dictation (bind this to a keyboard shortcut)
# utter meeting    start or stop meeting notes (Alt+M)
# utter settings   open the window: history, API key, typing mode, microphone
# utter quit       stop Utter (the next `utter` starts it again)
set -euo pipefail
svc=utter
case "${1:-toggle}" in
  toggle) sig=USR1 ;;
  meeting) sig=RTMIN+1 ;;  # start or stop meeting notes (Alt+M)
  settings|history|open) sig=USR2 ;;
  quit|stop) exec systemctl --user stop "$svc" ;;
  -h|--help|help) sed -n '2,5p' "$0" | sed 's/^# //'; exit 0 ;;
  *) echo "utter: unknown command '$1' (try: utter --help)" >&2; exit 2 ;;
esac
if ! systemctl --user is-active --quiet "$svc"; then
  touch "${XDG_RUNTIME_DIR:-/tmp}/utter-started-by-hand"  # so it runs even with "Start at login" off
  systemctl --user start "$svc"
fi
# A signal that lands before Utter has set up its handlers would kill it, so wait (up to 5 s) until it says it is
# ready: it writes its PID to this file the moment it can take presses. Presses before it has connected are queued.
ready="${XDG_RUNTIME_DIR:-/tmp}/utter.ready"
for _ in $(seq 1 100); do
  pid=$(systemctl --user show -p MainPID --value "$svc")
  [ "$pid" != 0 ] && [ "$(cat "$ready" 2>/dev/null)" = "$pid" ] && break
  sleep 0.05
done
systemctl --user kill -s "$sig" --kill-whom=main "$svc"
