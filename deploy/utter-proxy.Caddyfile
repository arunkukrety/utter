# The load balancer in front of utter-server@a and @b. Tailscale Funnel sends the app here (127.0.0.1:8191).
# An instance gets traffic only while its /health answers 200: a new one once it is warm, never an old one once it
# starts draining. If a connection attempt fails, the proxy retries the other instance for up to 5 s.
{
	admin off
	auto_https off
	# sites are :PORT, not http://127.0.0.1:PORT: Funnel forwards the public Host header, which a host-specific
	# site does not match (Caddy then answers an empty 200)
}

:8191 {
	bind 127.0.0.1
	reverse_proxy 127.0.0.1:18191 127.0.0.1:28191 {
		lb_try_duration 5s
		lb_try_interval 100ms
		health_uri /health
		health_interval 1s
		health_timeout 2s
		fail_duration 2s
	}
}

:8190 {
	bind 127.0.0.1
	reverse_proxy 127.0.0.1:18190 127.0.0.1:28190 {
		lb_try_duration 5s
		lb_try_interval 100ms
		health_uri /health
		health_interval 1s
		health_timeout 2s
		fail_duration 2s
	}
}
